{
  "$schema": "config.schema.json",
  "postgresApi": {
    "enabled": true,
    "host": "localhost",
    "port": 8000,
    "openApiFilePath": "./cfg/pgOpenApi.yaml",
    "database": {
      "hosts": [
        "localhost:5432"
      ],
      "username": "postgres",
      "password": "admin",
      "databaseName": "database-proxy"
    }
  },
  "cockroachApi": {
    "enabled": true,
    "host": "localhost",
    "port": 8010,
    "openApiFilePath": "./cfg/crbOpenApi.yaml",
    "database": {
      "hosts": [
        "localhost:26257"
      ],
      "sslEnabled": false,
      "sslCertPath": "cfg/dummy-cert.pem",
      "username": "root",
      "password": "",
      "databaseName": "defaultdb"
    }
  },
  "cassandraApi": {
    "enabled": true,
    "host": "localhost",
    "port": 8020,
    "openApiFilePath": "./cfg/cassandraOpenApi.yaml",
    "allowFiltering": true,
    "database": {
      "hosts": [
        "localhost:9042"
      ],
      "username": "cassandra",
      "password": "cassandra",
      "databaseName": "music",
      "localDatacenter": "datacenter1"
    }
  }
}
