<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" monitorInterval="30">

    <Properties>
        <Property name="CLR">
            {FATAL=red blink, ERROR=red, WARN=yellow bold,INFO=green, DEBUG=green bold, TRACE=blue}
        </Property>
        <Property name="LOG_PATTERN"
                  value="%d{yyyy-MM-dd'T'HH:mm:ss.SSS} ll=%highlight{%-5level}${CLR} t=%thread c=%style{%c{1.}}{cyan}"/>
    </Properties>

    <Appenders>
        <Console name="Console" target="SYSTEM_OUT" follow="true">
            <PatternLayout disableAnsi="false">
                <Pattern>${LOG_PATTERN} msg="%m"%n</Pattern>
            </PatternLayout>
        </Console>
    </Appenders>

    <Loggers>
        <Root level="info" additivity="false">
            <AppenderRef ref="Console"/>
        </Root>

        <Logger name="com.dercio.database_proxy" level="info" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
    </Loggers>

</Configuration>